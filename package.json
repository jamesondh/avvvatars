{
  "name": "@jamesonhodge/avvvatars-react",
  "version": "0.5.1",
  "description": "Generates unique placeholder avatars with either characters or shapes for React projects and Node.js environments.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/avvvatars-react.esm.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/avvvatars-react.esm.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.esm.js"
      },
      "require": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.cjs.js"
      }
    }
  },
  "scripts": {
    "build:shapes": "node scripts/generate-shapes-data.mjs",
    "build": "npm run build:shapes && tsdx build",
    "prepublishOnly": "npm run build"
  },
  "author": "Nusu Alabuga",
  "license": "MIT",
  "keywords": [
    "placeholder avatars",
    "avatars",
    "react",
    "svg",
    "node",
    "headless",
    "random avatar"
  ],
  "devDependencies": {
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "typescript": "^4.0.0",
    "tsdx": "^0.14.1",
    "fs-extra": "^11.0.0"
  },
  "peerDependencies": {
    "react": ">= 16",
    "react-dom": ">= 16"
  },
  "dependencies": {
    "goober": "^2.1.8"
  },
  "files": [
    "dist",
    "src",
    "scripts"
  ]
}
